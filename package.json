{
  "name": "linux-whatsapp-web",
  "version": "1.0.0",
  "description": "A custom native wrapper for WhatsApp Web on Linux",
  "homepage": "https://web.whatsapp.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux deb"
  },
  "author": "s3n3t3",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.custom.whatsapp",
    "productName": "WhatsApp Custom",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "deb",
      "category": "Network",
      "icon": "icon.png",
      "maintainer": "s3n3t3"
    }
  }
}
